# SPDX-License-Identifier: Apache-2.0
#
# System hosts support for the built-in AdAway (see org.adaway.model.system.SystemHosts).
#
# /data/misc/adaway/hosts is bind mounted over /system/etc/hosts. AdAway writes its
# blocklist to /data/misc/adaway/blocklist (kept across reboots) and to the live
# hosts file (takes effect at once). Only init and platform-signed apps may write
# here, enforced by SELinux (adblock/sepolicy); the file modes are open so that
# no ownership handover is needed at runtime.

on post-fs-data
    mkdir /data/misc/adaway 0777 system system
    # Start from the stock hosts file, then the last blocklist if there is one
    copy /system/etc/hosts /data/misc/adaway/hosts
    copy /data/misc/adaway/blocklist /data/misc/adaway/hosts
    chmod 0666 /data/misc/adaway/hosts
    restorecon /data/misc/adaway/hosts
    mount none /data/misc/adaway/hosts /system/etc/hosts bind
