# System hosts support for the built-in AdAway, see adaway.rc

# The directory and AdAway's blocklist
type adaway_data_file, file_type, data_file_type, core_data_file_type;
# The live hosts file, mounted over /system/etc/hosts
type adaway_hosts_file, file_type, data_file_type, core_data_file_type;
system_internal_prop(adaway_prop)

# At boot init creates the directory, copies the blocklist into the live hosts
# file and bind mounts it over /system/etc/hosts
allow init adaway_data_file:dir create_dir_perms;
allow init adaway_data_file:file create_file_perms;
allow init adaway_hosts_file:file create_file_perms;
allow init adaway_data_file:file relabelfrom;
allow init adaway_hosts_file:file relabelto;
allow init system_file:file mounton;

# AdAway is signed with the platform key: it writes its blocklist and the live
# hosts file, and reads the hosts file back to show whether blocking is active.
# platform_app_all covers platform_app and platform_app_36, the domain Android 17
# gives platform-signed apps that target an older SDK, like AdAway.
allow platform_app_all adaway_data_file:dir rw_dir_perms;
allow platform_app_all adaway_data_file:file create_file_perms;
allow platform_app_all adaway_hosts_file:file rw_file_perms;
get_prop(platform_app_all, adaway_prop)

# Everyone reads /system/etc/hosts: the DNS resolver in netd checks it before
# every lookup, and apps on Chromium's network stack (Chrome, WebView, Play
# services, YouTube) read it themselves
allow domain adaway_hosts_file:file r_file_perms;
